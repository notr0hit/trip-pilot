# Choose at least one free-tier LLM provider key (or use Demo Mode in the UI without keys)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional default overrides
TRIPPILOT_DEFAULT_PROVIDER=auto
TRIPPILOT_GEMINI_MODEL=gemini-2.5-flash
TRIPPILOT_GROQ_MODEL=openai/gpt-oss-120b
TRIPPILOT_DB_PATH=trippilot_checkpoints.db

# Optional free LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trippilot

